{
  "schema_version": 3,
  "commands": [
    {
      "command": "model.settings",
      "name": "settings",
      "analysis": "plane-strain",
      "units": {
        "length": "mm",
        "force": "N"
      }
    },
    {
      "command": "parameter.add",
      "name": "radius",
      "value": 10,
      "quantity": "length",
      "min": 2,
      "max": 30,
      "step": 1,
      "description": "Radius of the hole"
    },
    {
      "command": "parameter.add",
      "name": "width",
      "value": 40,
      "quantity": "length",
      "min": 35,
      "max": 100,
      "step": 5,
      "description": "Half width of the plate"
    },
    {
      "command": "parameter.add",
      "name": "cells",
      "value": 8,
      "min": 3,
      "max": 20,
      "integer": true,
      "description": "Number of cells along an edge"
    },
    {
      "command": "mesh.script",
      "name": "plate_mesh",
      "file": "plate_with_hole.py"
    },
    {
      "command": "cellset.from_file",
      "name": "plate_cells",
      "mesh": "plate_mesh"
    },
    {
      "command": "material.add",
      "name": "steel",
      "model": "LinearElasticPlasticIsotropicHardening",
      "parameters": {
        "E": 210000,
        "nu": 0.3,
        "sigma_y": 250,
        "K": 1000
      }
    },
    {
      "command": "section.add",
      "name": "plate",
      "cellset": "plate_cells",
      "material": "steel",
      "formulation": "u"
    },
    {
      "command": "symmetry.add",
      "name": "quarter",
      "axes": [
        "x",
        "y"
      ]
    },
    {
      "command": "pointset.add",
      "name": "end",
      "select": {
        "bound": "max",
        "axis": "x"
      }
    },
    {
      "command": "boundary.add",
      "name": "pull",
      "pointset": "end",
      "constrained": [
        "x"
      ]
    },
    {
      "command": "step.add",
      "name": "loading",
      "ramp": {
        "num": 10,
        "items": [
          {
            "target": "pull",
            "end": 0.1
          }
        ]
      }
    },
    {
      "command": "step.add",
      "name": "unloading",
      "ramp": {
        "num": 10,
        "items": [
          {
            "target": "pull",
            "start": 0.1,
            "end": 0
          }
        ]
      }
    },
    {
      "command": "job.add",
      "name": "job",
      "steps": [
        "loading",
        "unloading"
      ],
      "curve": "pull",
      "cutback": {}
    }
  ]
}
