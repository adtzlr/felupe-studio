{
  "schema_version": 3,
  "commands": [
    {
      "command": "model.settings",
      "name": "settings",
      "analysis": "axisymmetric",
      "units": {
        "length": "mm",
        "force": "N"
      }
    },
    {
      "command": "parameter.add",
      "name": "radius",
      "value": 50,
      "quantity": "length",
      "min": 20,
      "max": 100,
      "step": 5,
      "description": "Radius of the discs"
    },
    {
      "command": "parameter.add",
      "name": "layers",
      "value": 3,
      "min": 1,
      "max": 6,
      "integer": true,
      "description": "Number of rubber layers"
    },
    {
      "command": "parameter.add",
      "name": "height",
      "value": 8,
      "quantity": "length",
      "min": 2,
      "max": 20,
      "step": 1,
      "description": "Height of a rubber layer"
    },
    {
      "command": "parameter.add",
      "name": "sheet",
      "value": 2,
      "quantity": "length",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "description": "Thickness of a steel sheet"
    },
    {
      "command": "parameter.add",
      "name": "cells",
      "value": 10,
      "min": 4,
      "max": 30,
      "integer": true,
      "description": "Number of cells along the radius"
    },
    {
      "command": "parameter.add",
      "name": "cells_height",
      "value": 4,
      "min": 1,
      "max": 12,
      "integer": true,
      "description": "Number of cells through a rubber layer"
    },
    {
      "command": "mesh.script",
      "name": "rubber_mesh",
      "file": "sandwich_spring_2d.py",
      "item": "rubber"
    },
    {
      "command": "mesh.script",
      "name": "metal_mesh",
      "file": "sandwich_spring_2d.py",
      "item": "metal"
    },
    {
      "command": "cellset.from_file",
      "name": "rubber_cells",
      "mesh": "rubber_mesh"
    },
    {
      "command": "cellset.from_file",
      "name": "metal_cells",
      "mesh": "metal_mesh"
    },
    {
      "command": "material.add",
      "name": "rubber",
      "model": "NeoHooke",
      "parameters": {
        "mu": 0.5
      }
    },
    {
      "command": "material.add",
      "name": "steel",
      "model": "LinearElasticLargeStrain",
      "parameters": {
        "E": 210000,
        "nu": 0.3
      }
    },
    {
      "command": "section.add",
      "name": "rubber_layers",
      "cellset": "rubber_cells",
      "material": "rubber",
      "formulation": "u-p-J",
      "bulk": 1000
    },
    {
      "command": "section.add",
      "name": "steel_sheets",
      "cellset": "metal_cells",
      "material": "steel",
      "formulation": "u"
    },
    {
      "command": "pointset.add",
      "name": "first",
      "select": {
        "bound": "min",
        "axis": "x"
      }
    },
    {
      "command": "pointset.add",
      "name": "last",
      "select": {
        "bound": "max",
        "axis": "x"
      }
    },
    {
      "command": "symmetry.add",
      "name": "axis",
      "axes": [
        "y"
      ]
    },
    {
      "command": "boundary.add",
      "name": "fixed",
      "pointset": "last",
      "constrained": [
        "x",
        "y"
      ]
    },
    {
      "command": "boundary.add",
      "name": "press",
      "pointset": "first",
      "constrained": [
        "x"
      ]
    },
    {
      "command": "boundary.add",
      "name": "guide",
      "pointset": "first",
      "constrained": [
        "y"
      ]
    },
    {
      "command": "step.add",
      "name": "pressing",
      "ramp": {
        "num": 8,
        "items": [
          {
            "target": "press",
            "end": 4
          }
        ]
      }
    },
    {
      "command": "job.add",
      "name": "job",
      "steps": [
        "pressing"
      ],
      "curve": "press"
    }
  ]
}
