{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adtzlr/felupe-studio/commands.schema.json",
  "title": "CommandList",
  "description": "A list of FElupe Studio commands. Objects are created by commands and referenced by their names.",
  "type": "object",
  "required": ["schema_version", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Version of this schema.",
      "const": 2
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Command"
      }
    }
  },
  "$defs": {
    "Name": {
      "description": "Name of an object, unique within the command list. Used as a Python identifier in the generated script; at most 24 characters keep the script readable.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 24,
      "x-reserved": {
        "$comment": "Names that must not be used, because the generated script uses them (felupe_studio.codegen). Checked by felupe_studio.commands and app/src/core/validate.ts.",
        "keywords": [
          "False",
          "None",
          "True",
          "and",
          "as",
          "assert",
          "async",
          "await",
          "break",
          "class",
          "continue",
          "def",
          "del",
          "elif",
          "else",
          "except",
          "finally",
          "for",
          "from",
          "global",
          "if",
          "import",
          "in",
          "is",
          "lambda",
          "nonlocal",
          "not",
          "or",
          "pass",
          "raise",
          "return",
          "try",
          "while",
          "with",
          "yield"
        ],
        "names": [
          "DIMENSIONS",
          "REGIONS",
          "SimpleNamespace",
          "boundaries",
          "control_points",
          "fem",
          "field",
          "meshio",
          "mixed_region",
          "np",
          "points",
          "points_at",
          "single_point",
          "vertex_region",
          "volume_cells"
        ],
        "prefixes": ["field_", "solid_", "region_", "ramp_"]
      }
    },
    "Axis": {
      "type": "string",
      "enum": ["x", "y", "z"]
    },
    "Coordinates": {
      "description": "The coordinates x, y and z of a point.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Command": {
      "oneOf": [
        {
          "$ref": "#/$defs/MeshImport"
        },
        {
          "$ref": "#/$defs/MeshMerge"
        },
        {
          "$ref": "#/$defs/CellSetFromTag"
        },
        {
          "$ref": "#/$defs/CellSetFromFile"
        },
        {
          "$ref": "#/$defs/MaterialAdd"
        },
        {
          "$ref": "#/$defs/SectionAdd"
        },
        {
          "$ref": "#/$defs/PointSetAdd"
        },
        {
          "$ref": "#/$defs/PointAdd"
        },
        {
          "$ref": "#/$defs/BoundaryAdd"
        },
        {
          "$ref": "#/$defs/LoadcaseAdd"
        },
        {
          "$ref": "#/$defs/MpcAdd"
        },
        {
          "$ref": "#/$defs/LoadAdd"
        },
        {
          "$ref": "#/$defs/StepAdd"
        },
        {
          "$ref": "#/$defs/JobAdd"
        }
      ]
    },
    "MeshImport": {
      "description": "Import a mesh file (read with meshio).",
      "type": "object",
      "required": ["command", "name", "file"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "mesh.import"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "file": {
          "description": "File name of the mesh, e.g. specimen.vtu.",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "Name of an integer cell data array used to split the mesh into cell sets, e.g. material or gmsh:physical.",
          "type": "string",
          "minLength": 1
        },
        "cell_type": {
          "description": "Type of the solid cells to import, if the file has more than one (one mesh per cell type).",
          "enum": ["tetra", "tetra10", "hexahedron", "hexahedron20", "hexahedron27"]
        }
      }
    },
    "MeshMerge": {
      "description": "Merge points of the sections whose coordinates agree to the given number of decimals (fem.field.merge(..., decimals)). Without this command, only identical points are merged. Merged points take the rounded coordinates.",
      "type": "object",
      "required": ["command", "name", "decimals"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "mesh.merge"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "decimals": {
          "description": "Number of decimals of the point coordinates compared for merging, e.g. 6.",
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "CellSetFromTag": {
      "description": "Cell set of all cells of a mesh with the given tag value.",
      "type": "object",
      "required": ["command", "name", "mesh", "value"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "cellset.from_tag"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "mesh": {
          "$ref": "#/$defs/Name"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "CellSetFromFile": {
      "description": "Cell set of all cells of a mesh.",
      "type": "object",
      "required": ["command", "name", "mesh"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "cellset.from_file"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "mesh": {
          "$ref": "#/$defs/Name"
        }
      }
    },
    "MaterialAdd": {
      "description": "Add a material to the material library. Every model is a definition below (the material registry): its label, the FElupe class or tensortrax function, and its parameters with label, description, bounds and default.",
      "oneOf": [
        {
          "$ref": "#/$defs/MaterialNeoHooke"
        },
        {
          "$ref": "#/$defs/MaterialNeoHookeCompressible"
        },
        {
          "$ref": "#/$defs/MaterialMooneyRivlin"
        },
        {
          "$ref": "#/$defs/MaterialLinearElasticLargeStrain"
        }
      ]
    },
    "MaterialNeoHooke": {
      "description": "Isotropic hyperelastic Neo-Hookean material (fem.NeoHooke). Without a bulk modulus it needs the u-p-J formulation.",
      "x-label": "Neo-Hooke",
      "x-felupe": { "class": "fem.NeoHooke" },
      "type": "object",
      "required": ["command", "name", "model", "parameters"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "material.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "model": {
          "const": "NeoHooke"
        },
        "parameters": {
          "type": "object",
          "required": ["mu"],
          "additionalProperties": false,
          "properties": {
            "mu": {
              "x-label": "μ",
              "description": "Shear modulus",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "bulk": {
              "x-label": "K",
              "description": "Bulk modulus. Without it, the material is incompressible and needs the u-p-J formulation.",
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "MaterialNeoHookeCompressible": {
      "description": "Compressible isotropic hyperelastic Neo-Hookean material (fem.NeoHookeCompressible).",
      "x-label": "Neo-Hooke (compressible)",
      "x-felupe": { "class": "fem.NeoHookeCompressible" },
      "type": "object",
      "required": ["command", "name", "model", "parameters"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "material.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "model": {
          "const": "NeoHookeCompressible"
        },
        "parameters": {
          "type": "object",
          "required": ["mu", "lmbda"],
          "additionalProperties": false,
          "properties": {
            "mu": {
              "x-label": "μ",
              "description": "Shear modulus",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "lmbda": {
              "x-label": "λ",
              "description": "First Lamé parameter",
              "type": "number",
              "minimum": 0,
              "default": 2
            }
          }
        }
      }
    },
    "MaterialMooneyRivlin": {
      "description": "Isotropic hyperelastic Mooney-Rivlin material (fem.Hyperelastic with fem.mooney_rivlin, needs tensortrax). The shear modulus is 2 (C10 + C01). Without a bulk modulus it needs the u-p-J formulation.",
      "x-label": "Mooney-Rivlin",
      "x-felupe": { "function": "fem.mooney_rivlin" },
      "type": "object",
      "required": ["command", "name", "model", "parameters"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "material.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "model": {
          "const": "MooneyRivlin"
        },
        "parameters": {
          "type": "object",
          "required": ["C10", "C01"],
          "additionalProperties": false,
          "properties": {
            "C10": {
              "x-label": "C₁₀",
              "description": "Material parameter of the first invariant",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.4
            },
            "C01": {
              "x-label": "C₀₁",
              "description": "Material parameter of the second invariant",
              "type": "number",
              "default": 0.1
            },
            "bulk": {
              "x-label": "K",
              "description": "Bulk modulus. Without it, the material is incompressible and needs the u-p-J formulation.",
              "type": "number",
              "exclusiveMinimum": 0,
              "x-felupe": "volumetric"
            }
          }
        }
      }
    },
    "MaterialLinearElasticLargeStrain": {
      "description": "Linear-elastic material formulated for large deformations (fem.LinearElasticLargeStrain).",
      "x-label": "Linear elastic (large strain)",
      "x-felupe": { "class": "fem.LinearElasticLargeStrain" },
      "type": "object",
      "required": ["command", "name", "model", "parameters"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "material.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "model": {
          "const": "LinearElasticLargeStrain"
        },
        "parameters": {
          "type": "object",
          "required": ["E", "nu"],
          "additionalProperties": false,
          "properties": {
            "E": {
              "x-label": "E",
              "description": "Young's modulus",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "nu": {
              "x-label": "ν",
              "description": "Poisson's ratio",
              "type": "number",
              "minimum": -1,
              "exclusiveMaximum": 0.5,
              "default": 0.3
            }
          }
        }
      }
    },
    "SectionAdd": {
      "description": "Assign a material and a formulation to a cell set. Each section becomes a solid body.",
      "type": "object",
      "required": ["command", "name", "cellset", "material", "formulation"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "section.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "cellset": {
          "$ref": "#/$defs/Name"
        },
        "material": {
          "$ref": "#/$defs/Name"
        },
        "formulation": {
          "description": "u: displacement field only. u-p-J: mixed fields (fem.FieldsMixed) for nearly incompressible materials.",
          "enum": ["u", "u-p-J"]
        },
        "bulk": {
          "description": "Bulk modulus of the nearly incompressible formulation (required for u-p-J).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "if": {
        "properties": {
          "formulation": {
            "const": "u-p-J"
          }
        }
      },
      "then": {
        "required": ["bulk"]
      },
      "else": {
        "not": {
          "required": ["bulk"]
        }
      }
    },
    "PointSetAdd": {
      "description": "Points of the merged mesh selected by a plane, by the coordinates of points or by point ids.",
      "type": "object",
      "required": ["command", "name", "select"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "pointset.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "select": {
          "oneOf": [
            {
              "description": "Points with the given coordinate, e.g. x == 0.",
              "type": "object",
              "required": ["axis", "value"],
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "$ref": "#/$defs/Axis"
                },
                "value": {
                  "type": "number"
                },
                "atol": {
                  "description": "Absolute tolerance (default 1e-8).",
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "description": "The points at the given coordinates, one point each, e.g. picked nodes. A coordinate without a point is an error of the script.",
              "type": "object",
              "required": ["points"],
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/Coordinates"
                  }
                },
                "atol": {
                  "description": "Absolute tolerance (default 1e-8).",
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "description": "Points given by their ids, e.g. picked in the viewer.",
              "type": "object",
              "required": ["ids"],
              "additionalProperties": false,
              "properties": {
                "ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "PointAdd": {
      "description": "A control point that is not a node of the meshes, e.g. the center point of a multi-point constraint. It is a point set of one point: all control points form a mesh of vertices that is merged with the fields of the sections.",
      "type": "object",
      "required": ["command", "name", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "point.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "coordinates": {
          "$ref": "#/$defs/Coordinates"
        }
      }
    },
    "BoundaryAdd": {
      "description": "Prescribe displacement components of a point set (fem.Boundary).",
      "type": "object",
      "required": ["command", "name", "pointset", "constrained"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "boundary.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "pointset": {
          "$ref": "#/$defs/Name"
        },
        "constrained": {
          "description": "Constrained displacement components; all others are free.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Axis"
          }
        },
        "value": {
          "description": "Prescribed displacement of the constrained components (default 0).",
          "type": "number"
        }
      }
    },
    "LoadcaseAdd": {
      "description": "A load case of FElupe (fem.dof) on the merged field: the boundaries of a standard test. It is referenced like a boundary: a step ramps its moving end faces, a job records the reaction force of its (first) moving end face.",
      "oneOf": [
        {
          "$ref": "#/$defs/LoadcaseUniaxial"
        },
        {
          "$ref": "#/$defs/LoadcaseBiaxial"
        },
        {
          "$ref": "#/$defs/LoadcasePlanar"
        },
        {
          "$ref": "#/$defs/LoadcaseShear"
        }
      ]
    },
    "LoadcaseUniaxial": {
      "description": "Uniaxial tension or compression along an axis (fem.dof.uniaxial). The end face at the largest coordinate moves.",
      "x-label": "Uniaxial",
      "x-felupe": { "function": "fem.dof.uniaxial" },
      "type": "object",
      "required": ["command", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "loadcase.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "const": "uniaxial"
        },
        "axis": {
          "description": "Direction of the loading (default x).",
          "$ref": "#/$defs/Axis"
        },
        "clamped": {
          "description": "Rigid end faces: no transversal displacements of the moving (and, without symmetry, the opposite) end faces.",
          "type": "boolean",
          "default": false
        },
        "symmetry": {
          "description": "Symmetry planes at x = 0, y = 0 and z = 0 (a quarter or an eighth of a model). Without them, the opposite end faces are at the smallest coordinates.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "LoadcaseBiaxial": {
      "description": "Equi-biaxial tension along two axes (fem.dof.biaxial). The end faces at the largest coordinates move.",
      "x-label": "Biaxial",
      "x-felupe": { "function": "fem.dof.biaxial" },
      "type": "object",
      "required": ["command", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "loadcase.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "const": "biaxial"
        },
        "axis": {
          "description": "First direction of the loading (default x).",
          "$ref": "#/$defs/Axis"
        },
        "second": {
          "description": "Second direction of the loading (default y).",
          "$ref": "#/$defs/Axis"
        },
        "clamped": {
          "description": "Rigid end faces: no transversal displacements of the moving (and, without symmetry, the opposite) end faces.",
          "type": "boolean",
          "default": false
        },
        "symmetry": {
          "description": "Symmetry planes at x = 0, y = 0 and z = 0 (a quarter or an eighth of a model). Without them, the opposite end faces are at the smallest coordinates.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "LoadcasePlanar": {
      "description": "Planar (pure shear) tension along an axis with a constant width along a second axis (fem.dof.biaxial without a move of the second axis).",
      "x-label": "Planar",
      "x-felupe": { "function": "fem.dof.biaxial" },
      "type": "object",
      "required": ["command", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "loadcase.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "const": "planar"
        },
        "axis": {
          "description": "Direction of the loading (default x).",
          "$ref": "#/$defs/Axis"
        },
        "second": {
          "description": "Direction of the constant width (default y).",
          "$ref": "#/$defs/Axis"
        },
        "clamped": {
          "description": "Rigid end faces: no transversal displacements of the moving (and, without symmetry, the opposite) end faces.",
          "type": "boolean",
          "default": false
        },
        "symmetry": {
          "description": "Symmetry planes at x = 0, y = 0 and z = 0 (a quarter or an eighth of a model). Without them, the opposite end faces are at the smallest coordinates.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "LoadcaseShear": {
      "description": "Simple shear between the end faces normal to an axis (fem.dof.shear). The face at the largest coordinate moves along the shear direction.",
      "x-label": "Shear",
      "x-felupe": { "function": "fem.dof.shear" },
      "type": "object",
      "required": ["command", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "loadcase.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "const": "shear"
        },
        "axis": {
          "description": "Direction of the shear (default x).",
          "$ref": "#/$defs/Axis"
        },
        "normal": {
          "description": "Normal of the sheared end faces (default y).",
          "$ref": "#/$defs/Axis"
        },
        "compression": {
          "description": "Displacement of the moving face along the normal, held during the shear (default 0).",
          "type": "number"
        },
        "symmetry": {
          "description": "Symmetry plane normal to the third axis at its zero coordinate.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "MpcAdd": {
      "description": "A multi-point constraint (fem.MultiPointConstraint): the points of a point set follow a center point rigidly, connected by a penalty. With a rotation point, they also rotate about the center point.",
      "type": "object",
      "required": ["command", "name", "points", "center", "constrained"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "mpc.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "points": {
          "description": "The point set of the connected points.",
          "$ref": "#/$defs/Name"
        },
        "center": {
          "description": "The center point: a control point or a point set of one point.",
          "$ref": "#/$defs/Name"
        },
        "constrained": {
          "description": "The connected components (skip the others). All of them with a rotation point.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Axis"
          }
        },
        "multiplier": {
          "description": "The penalty of the relative displacements (default 1000).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "description": "The rotation point: a control point or a point set of one point, whose values are the rotations about the center point in rad (its coordinates are not used).",
          "$ref": "#/$defs/Name"
        }
      }
    },
    "LoadAdd": {
      "description": "A point load (fem.PointLoad): a force at every point of a point set or at a control point, an item of the steps. A ramp of a step scales the force.",
      "type": "object",
      "required": ["command", "name", "points", "force"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "load.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "points": {
          "description": "The point set or the control point of the load.",
          "$ref": "#/$defs/Name"
        },
        "force": {
          "description": "The force fx, fy, fz at every point.",
          "$ref": "#/$defs/Coordinates"
        }
      }
    },
    "StepAdd": {
      "description": "A step with all boundaries, optionally ramping items, each with its own values (fem.Step).",
      "type": "object",
      "required": ["command", "name"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "step.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "sections": {
          "description": "Sections whose solid bodies are items of the step (default: all).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "constraints": {
          "description": "Multi-point constraints that are items of the step (default: all).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "loads": {
          "description": "Point loads that are items of the step (default: all).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "ramp": {
          "description": "Ramp the values of items with fem.math.linsteps([start, end], num), with the same number of increments for all items.",
          "type": "object",
          "required": ["num", "items"],
          "additionalProperties": false,
          "properties": {
            "num": {
              "description": "Increments of the step.",
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/RampItem"
              }
            }
          }
        }
      }
    },
    "RampItem": {
      "description": "A ramped item: a boundary (its value, e.g. a displacement), a load case (the displacement of its moving faces) or a point load (a factor of its force).",
      "type": "object",
      "required": ["target", "end"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Name"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      }
    },
    "JobAdd": {
      "description": "A job evaluating steps (fem.Job). With a curve boundary, the reaction force of this boundary is recorded over its displacement (fem.CharacteristicCurve).",
      "type": "object",
      "required": ["command", "name", "steps"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "job.add"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "curve": {
          "$ref": "#/$defs/Name"
        },
        "cutback": {
          "description": "Retry a substep that does not converge with smaller increments (fem.CutbackPlugin).",
          "type": "boolean",
          "default": false
        },
        "tol": {
          "description": "Tolerance of the Newton-Raphson method: the norm of the residual forces relative to the reaction forces (default: the square root of the machine epsilon, 1.49e-8).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
