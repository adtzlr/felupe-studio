{
  "schema_version": 3,
  "commands": [
    {
      "command": "mesh.import",
      "name": "block",
      "file": "block.vtu"
    },
    {
      "command": "cellset.from_file",
      "name": "all_cells",
      "mesh": "block"
    },
    {
      "command": "material.add",
      "name": "soft",
      "model": "NeoHookeCompressible",
      "parameters": {
        "mu": 1.0,
        "lmbda": 2.0
      }
    },
    {
      "command": "section.add",
      "name": "body",
      "cellset": "all_cells",
      "material": "soft",
      "formulation": "u"
    },
    {
      "command": "pointset.add",
      "name": "x_min",
      "select": {
        "axis": "x",
        "value": 0
      }
    },
    {
      "command": "pointset.add",
      "name": "y_min",
      "select": {
        "axis": "y",
        "value": 0
      }
    },
    {
      "command": "pointset.add",
      "name": "z_min",
      "select": {
        "axis": "z",
        "value": 0
      }
    },
    {
      "command": "pointset.add",
      "name": "top",
      "select": {
        "axis": "z",
        "value": 1
      }
    },
    {
      "command": "rigid.add",
      "name": "roller",
      "coordinates": [
        0,
        0.5,
        3
      ],
      "shape": {
        "radius": 2,
        "axis": [
          0,
          1,
          0
        ]
      }
    },
    {
      "command": "boundary.add",
      "name": "symmetry_x",
      "pointset": "x_min",
      "constrained": [
        "x"
      ]
    },
    {
      "command": "boundary.add",
      "name": "symmetry_y",
      "pointset": "y_min",
      "constrained": [
        "y"
      ]
    },
    {
      "command": "boundary.add",
      "name": "symmetry_z",
      "pointset": "z_min",
      "constrained": [
        "z"
      ]
    },
    {
      "command": "boundary.add",
      "name": "press",
      "pointset": "roller",
      "constrained": [
        "z"
      ]
    },
    {
      "command": "boundary.add",
      "name": "guide",
      "pointset": "roller",
      "constrained": [
        "x",
        "y"
      ]
    },
    {
      "command": "contact.add",
      "name": "touch",
      "points": "top",
      "surface": "roller",
      "multiplier": 100
    },
    {
      "command": "step.add",
      "name": "step_1",
      "ramp": {
        "num": 5,
        "items": [
          {
            "target": "press",
            "end": -0.2
          }
        ]
      }
    },
    {
      "command": "job.add",
      "name": "job_1",
      "steps": [
        "step_1"
      ],
      "curve": "press",
      "tol": 1.49e-08
    }
  ]
}
