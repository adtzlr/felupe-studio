{
  "schema_version": 2,
  "commands": [
    {
      "command": "mesh.import",
      "name": "left_file",
      "file": "left.vtu"
    },
    {
      "command": "mesh.import",
      "name": "right_file",
      "file": "right.vtu"
    },
    {
      "command": "mesh.merge",
      "name": "merge",
      "decimals": 6
    },
    {
      "command": "cellset.from_file",
      "name": "left_half",
      "mesh": "left_file"
    },
    {
      "command": "cellset.from_file",
      "name": "right_half",
      "mesh": "right_file"
    },
    {
      "command": "material.add",
      "name": "rubber",
      "model": "NeoHookeCompressible",
      "parameters": {
        "mu": 1.0,
        "lmbda": 2.0
      }
    },
    {
      "command": "section.add",
      "name": "left_body",
      "cellset": "left_half",
      "material": "rubber",
      "formulation": "u"
    },
    {
      "command": "section.add",
      "name": "right_body",
      "cellset": "right_half",
      "material": "rubber",
      "formulation": "u"
    },
    {
      "command": "pointset.add",
      "name": "left",
      "select": {
        "axis": "x",
        "value": 0
      }
    },
    {
      "command": "pointset.add",
      "name": "right",
      "select": {
        "axis": "x",
        "value": 3
      }
    },
    {
      "command": "boundary.add",
      "name": "fixed",
      "pointset": "left",
      "constrained": [
        "x",
        "y",
        "z"
      ]
    },
    {
      "command": "boundary.add",
      "name": "move",
      "pointset": "right",
      "constrained": [
        "x"
      ]
    },
    {
      "command": "step.add",
      "name": "step_1",
      "ramp": {
        "num": 5,
        "items": [
          {
            "target": "move",
            "start": 0,
            "end": 0.5
          }
        ]
      }
    },
    {
      "command": "job.add",
      "name": "job_1",
      "steps": [
        "step_1"
      ],
      "curve": "move"
    }
  ]
}
