{
  "schema_version": 3,
  "commands": [
    {
      "command": "model.settings",
      "name": "settings",
      "analysis": "axisymmetric"
    },
    {
      "command": "mesh.import",
      "name": "plate",
      "file": "plate.vtu"
    },
    {
      "command": "cellset.from_file",
      "name": "all_cells",
      "mesh": "plate"
    },
    {
      "command": "material.add",
      "name": "rubber",
      "model": "NeoHookeCompressible",
      "parameters": {
        "mu": 1.0,
        "lmbda": 2.0
      }
    },
    {
      "command": "section.add",
      "name": "body",
      "cellset": "all_cells",
      "material": "rubber",
      "formulation": "u"
    },
    {
      "command": "pointset.add",
      "name": "x_min",
      "select": {
        "axis": "x",
        "value": 0
      }
    },
    {
      "command": "pointset.add",
      "name": "y_min",
      "select": {
        "axis": "y",
        "value": 0
      }
    },
    {
      "command": "faceset.add",
      "name": "end",
      "section": "body",
      "select": {
        "axis": "x",
        "value": 3
      }
    },
    {
      "command": "boundary.add",
      "name": "sym_x",
      "pointset": "x_min",
      "constrained": [
        "x"
      ]
    },
    {
      "command": "boundary.add",
      "name": "sym_y",
      "pointset": "y_min",
      "constrained": [
        "y"
      ]
    },
    {
      "command": "pressure.add",
      "name": "pull",
      "faces": "end",
      "pressure": -0.5
    },
    {
      "command": "step.add",
      "name": "step_1",
      "ramp": {
        "num": 5,
        "items": [
          {
            "target": "pull",
            "end": 1
          }
        ]
      }
    },
    {
      "command": "job.add",
      "name": "job_1",
      "steps": [
        "step_1"
      ],
      "curve": "sym_x",
      "tol": 1.49e-08
    }
  ]
}
